# API Testing Framework Configuration
# Скопируйте этот файл в .env и заполните реальными значениями

# Окружение (dev, staging, prod, test)
ENV=test

# Базовый URL API
BASE_URL=https://api.demo.com

# Таймаут для запросов (секунды)
TIMEOUT=10

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Настройки авторизации (опционально)
# Если не указаны, будут использованы значения по умолчанию
AUTH_USERNAME=test_user
AUTH_PASSWORD=test_password
AUTH_TOKEN=changeme

# Настройки для Allure отчетов
ALLURE_RESULTS_DIR=allure-results

# Настройки retry механизма
RETRY_COUNT=3
RETRY_DELAY=1.0
